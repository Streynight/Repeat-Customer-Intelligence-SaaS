# RepeatTree local environment example.
# Copy this file to .env.local for local development.
#
# Demo mode:
# - Supabase values may stay empty.
# - The app will use browser localStorage for demo/imported data.
#
# Production/beta mode:
# - Fill Supabase values from your Supabase project.
# - Set DATABASE_URL to your Supabase Postgres connection string.
# - Set NEXT_PUBLIC_APP_URL to your deployed Vercel URL.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth setup notes:
# - Enable Email/Password sign-ins in Supabase Auth.
# - Enable Google as an OAuth provider for "Continue with Google".
# - Add these redirect URLs in Supabase:
#   http://localhost:3000/auth/callback
#   https://your-production-domain.com/auth/callback

# Prisma / Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repeat_customer_intelligence"
# Optional. Use Supabase's direct connection string when pooler DATABASE_URL is used.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/repeat_customer_intelligence"

# Protects GET /api/sync/csv when Vercel Cron runs scheduled CSV imports.
CRON_SECRET=
