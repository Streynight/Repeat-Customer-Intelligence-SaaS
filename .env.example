# RepeatTree production environment example.
# Copy this file to .env.local for local development.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local demo mode is explicit and should stay false in production.
ALLOW_LOCAL_DEMO_MODE=false
NEXT_PUBLIC_ALLOW_LOCAL_DEMO_MODE=false

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma / Supabase Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repeat_customer_intelligence"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/repeat_customer_intelligence"

# Scheduled jobs and provider webhooks
CRON_SECRET=
INTEGRATION_WEBHOOK_SECRET=
HEALTHCHECK_SECRET=

# Redis / Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog product analytics and feature flags
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Sentry observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
